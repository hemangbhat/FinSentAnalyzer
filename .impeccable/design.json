      "css": ".ds-tag{font-family:'Public Sans',system-ui,sans-serif;display:inline-flex;align-items:center;gap:5px;padding:2px 9px;border-radius:4px;font-size:0.84em;font-weight:600;margin:2px;border:1px solid transparent;white-space:nowrap}.ds-pos{background:#E2F0E9;color:#1D7451;border-color:#BFDCCD}.ds-neg{background:#F6E4E2;color:#A3322B;border-color:#E6C3BF}.ds-neu{background:#E6EBEE;color:#4F6470;border-color:#CBD5DB}.ds-muted{background:#F2F5F4;color:#2E3F3C;border-color:#D5DEDC}"
    },
    {
      "name": "Sidebar Shell",
      "kind": "nav",
      "refersTo": "sidebar-shell",
      "description": "Deep-teal rail: grouped navigation, model engine, status.",
      "html": "<nav class=\"ds-shell\"><div class=\"ds-shell-group\">Analyze</div><a class=\"ds-shell-link ds-active\" href=\"#\">Single Analysis</a><a class=\"ds-shell-link\" href=\"#\">Batch Processing</a><div class=\"ds-shell-status\"><div><span class=\"ds-dot\" style=\"background:#6FD6A8\"></span>Engine ready</div><div><span class=\"ds-dot\" style=\"background:#8FD6C9\"></span>TF-IDF · classical ML</div></div></nav>",
      "css": ".ds-shell{font-family:'Public Sans',system-ui,sans-serif;background:#0B3A3C;color:#E3EEEC;padding:16px;width:220px}.ds-shell-group{color:#A9C4C0;font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;margin:12px 0 6px}.ds-shell-link{display:block;color:#E3EEEC;text-decoration:none;border-radius:5px;padding:5px 8px;font-size:0.9rem}.ds-shell-link:hover{background:rgba(143,214,201,0.08)}.ds-shell-link:focus-visible{outline:2px solid #8FD6C9;outline-offset:2px}.ds-active{background:rgba(143,214,201,0.14);box-shadow:inset 2px 0 0 #8FD6C9;color:#FFFFFF;font-weight:600}.ds-shell-status{border-top:1px solid #24595A;border-bottom:1px solid #24595A;padding:10px 2px;margin-top:12px;font-size:0.84rem}.ds-shell-status div{display:flex;align-items:center;gap:8px}.ds-shell-status div+div{margin-top:5px}.ds-dot{width:7px;height:7px;border-radius:50%}"
    },
    {
      "name": "Masthead and Exhibit",
      "kind": "custom",
      "refersTo": null,
      "description": "Page masthead, then a numbered exhibit with its source line.",
      "html": "<div class=\"ds-mast\"><h1>Financial sentiment, measured honestly</h1><p class=\"ds-stand\">Every result with its source and its uncertainty band.</p><div class=\"ds-meta\"><b>9</b> models · <b>116</b> automated tests</div></div><div class=\"ds-sec\"><h3><span class=\"ds-ex\">Exhibit 1</span>Macro-F1 by evaluation set</h3><p class=\"ds-cap\">A 0.90 test score did not survive real news.</p></div><div class=\"ds-src\">Source: results/bootstrap_ci.json</div>",
      "css": ".ds-mast,.ds-sec,.ds-src{font-family:'Public Sans',system-ui,sans-serif;}.ds-mast{border-top:3px solid #0E6E6A;padding-top:18px;margin-bottom:18px}.ds-mast h1{font-size:2.05rem;font-weight:700;line-height:1.15;letter-spacing:-0.015em;color:#12211F;margin:0 0 6px}.ds-stand{color:#4B5D5A;font-size:1.04rem;line-height:1.55;max-width:68ch;margin:0}.ds-meta{color:#5E6E6A;font-size:0.82rem;margin-top:12px}.ds-meta b{color:#2E3F3C;font-weight:600}.ds-sec{border-top:1px solid #D5DEDC;padding-top:14px;margin:34px 0 12px}.ds-sec h3{margin:0;font-size:1.14rem;font-weight:650;line-height:1.3;color:#12211F}.ds-ex{color:#0E6E6A;font-weight:700;margin-right:8px}.ds-cap{color:#4B5D5A;font-size:0.9rem;margin:4px 0 0;max-width:75ch}.ds-src{color:#5E6E6A;font-size:0.78rem}"
    },
    {
      "name": "Key-figure Row",
      "kind": "custom",
      "refersTo": "key-figure",
      "description": "Key figures as one ruled table row, not cards.",
      "html": "<div class=\"ds-figs\"><div class=\"ds-fig\"><div class=\"ds-l\">Fine-tuned FinBERT, real news</div><div class=\"ds-v\">0.84</div><div class=\"ds-s\">macro-F1, 95% CI 0.82–0.86</div></div><div class=\"ds-fig\"><div class=\"ds-l\">TF-IDF + SVM, real news</div><div class=\"ds-v\">0.46</div><div class=\"ds-s\">macro-F1</div></div><div class=\"ds-fig\"><div class=\"ds-l\">Held-out headlines</div><div class=\"ds-v\">2,388</div><div class=\"ds-s\">human-labelled</div></div></div>",
      "css": ".ds-figs{font-family:'Public Sans',system-ui,sans-serif;display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));border-top:1px solid #12211F;border-bottom:1px solid #D5DEDC}.ds-fig{padding:12px 16px;border-left:1px solid #D5DEDC}.ds-fig:first-child{border-left:none;padding-left:0}.ds-l{color:#4B5D5A;font-size:0.8rem;font-weight:600}.ds-v{color:#12211F;font-size:1.65rem;font-weight:700;line-height:1.25;margin-top:2px;font-variant-numeric:tabular-nums lining-nums}.ds-s{color:#5E6E6A;font-size:0.8rem;margin-top:2px;line-height:1.4}"
    },
    {
      "name": "Verdict with Probability Band",
      "kind": "custom",
      "refersTo": "probability-band",
      "description": "Signature: verdict word plus the spread of the model's belief.",
      "html": "<div class=\"ds-verdict\"><div class=\"ds-vl\">Predicted sentiment</div><div class=\"ds-word\"><span aria-hidden=\"true\">▲</span> Positive</div><div class=\"ds-conf\">Model confidence <b>81.0%</b></div><div class=\"ds-band\" role=\"img\" aria-label=\"Class probabilities\"><div style=\"width:6%;background:#F6E4E2\"></div><div style=\"width:13%;background:#E6EBEE\"></div><div style=\"width:81%;background:#1D7451\"></div></div><div class=\"ds-leg\"><div><div class=\"k\">▼ Negative</div><div class=\"v\">6.0%</div></div><div><div class=\"k\">▶ Neutral</div><div class=\"v\">13.0%</div></div><div><div class=\"k\">▲ Positive</div><div class=\"v\" style=\"color:#1D7451;font-weight:700\">81.0%</div></div></div></div>",
      "css": ".ds-verdict{font-family:'Public Sans',system-ui,sans-serif;border-top:1px solid #12211F;padding-top:14px;max-width:520px}.ds-vl{color:#4B5D5A;font-size:0.82rem;font-weight:600}.ds-word{color:#1D7451;font-size:2.6rem;font-weight:700;line-height:1.1;letter-spacing:-0.02em;margin:4px 0 2px}.ds-conf{color:#4B5D5A;font-size:0.95rem}.ds-conf b{color:#12211F;font-variant-numeric:tabular-nums}.ds-band{display:flex;height:26px;border-radius:3px;overflow:hidden;margin-top:16px;gap:2px}.ds-band>div{height:100%;min-width:2px}.ds-leg{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:8px}.ds-leg .k{font-size:0.82rem;color:#4B5D5A}.ds-leg .v{font-size:1.02rem;font-weight:650;color:#12211F;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Interval Row",
      "kind": "custom",
      "refersTo": null,
      "description": "Signature: dot, 95% band and end caps (HTML approximation of the Plotly interval chart).",
      "html": "<div class=\"ds-int\"><div class=\"ds-il\">FinBERT fine-tuned · real news (n=2,388)</div><div class=\"ds-track\"><div class=\"ds-iband\" style=\"left:82.3%;width:3.5%\"></div><div class=\"ds-dotm\" style=\"left:84.1%\"></div><span class=\"ds-iv\" style=\"left:87%\">0.84</span></div></div>",
      "css": ".ds-int{font-family:'Public Sans',system-ui,sans-serif;max-width:560px;padding:6px 0}.ds-il{font-size:12px;color:#2E3F3C;margin-bottom:6px}.ds-track{position:relative;height:16px;border-bottom:1px solid #E6ECEA}.ds-iband{position:absolute;top:4px;height:9px;background:rgba(14,110,106,0.25);border-left:2px solid #0E6E6A;border-right:2px solid #0E6E6A}.ds-dotm{position:absolute;top:3px;width:10px;height:10px;margin-left:-5px;border-radius:50%;background:#0E6E6A;box-shadow:0 0 0 1.5px #FFFFFF}.ds-iv{position:absolute;top:0;font-size:13px;font-weight:700;color:#12211F}"
    },
    {
      "name": "Term Table",
      "kind": "custom",
      "refersTo": null,
      "description": "Vocabulary as a ruled table with class-coloured weight bars.",
      "html": "<table class=\"ds-terms\"><thead><tr><th class=\"t\">Term</th><th>Weight</th><th></th><th class=\"c\">Pushes toward</th></tr></thead><tbody><tr><td class=\"t\">rose</td><td class=\"b\"><div style=\"height:6px;width:100%;background:#1D7451;border-radius:2px\"></div></td><td class=\"n\">1.842</td><td class=\"c\"><span style=\"color:#1D7451;font-weight:600\">▲ Positive</span></td></tr><tr><td class=\"t\">loss</td><td class=\"b\"><div style=\"height:6px;width:72%;background:#A3322B;border-radius:2px\"></div></td><td class=\"n\">1.327</td><td class=\"c\"><span style=\"color:#A3322B;font-weight:600\">▼ Negative</span></td></tr></tbody></table>",
      "css": ".ds-terms{font-family:'Public Sans',system-ui,sans-serif;width:100%;border-collapse:collapse;font-size:0.92rem}.ds-terms th,.ds-terms td{border-bottom:1px solid #D5DEDC;padding:7px 8px}.ds-terms thead th{color:#4B5D5A;font-size:0.78rem;font-weight:600;text-align:left;border-bottom:1px solid #12211F}.ds-terms .t{font-weight:600;color:#12211F;padding-left:0}.ds-terms .b{width:40%}.ds-terms .n{text-align:right;color:#2E3F3C;font-variant-numeric:tabular-nums}.ds-terms .c{text-align:right;padding-right:0}"
    },
